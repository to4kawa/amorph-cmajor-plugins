/*
    CMAJOR VOWEL EFFECT
    Algorithm: Formant Vowel Synthesis applied to input audio
    Remix change: Soft Clip is implemented as param6.
*/

processor VowelEffect
{
    input  stream float<2> in;
    output stream float<2> out;

    // ================= PARAMETERS =================
    input event float param1 [[ name: "Vowel Morph", min: 0, max: 4, init: 0 ]];
    input event float param2 [[ name: "Brightness", min: 0.5, max: 2.0, init: 1.0 ]];
    input event float param3 [[ name: "Resonance", min: 3.5, max: 20.0, init: 8.0 ]];
    input event float param5 [[ name: "Pitch", min: 0.5, max: 2.0, init: 1.0 ]];
    input event float param4 [[ name: "Dry/Wet", min: 0.0, max: 1.0, init: 0.5 ]];
    input event float param6 [[ name: "Soft Clip", min: 0.0, max: 1.0, init: 0.0 ]];

    float targetVowelPos = 0.0f;
    float targetBrightness = 1.0f;
    float targetResonance = 8.0f;
    float targetMixParam = 0.5f;
    float targetFormantShift = 1.0f;
    float targetSoftClip = 0.0f;

    float vowelPos = 0.0f;
    float brightness = 1.0f;
    float resonance = 8.0f;
    float mixParam = 0.5f;
    float formantShift = 1.0f;
    float softClip = 0.0f;

    event param1 (float v) { targetVowelPos = v; }
    event param2 (float v) { targetBrightness = v; }
    event param3 (float v) { targetResonance = v; }
    event param4 (float v) { targetMixParam = v; }
    event param5 (float v) { targetFormantShift = v; }
    event param6 (float v) { targetSoftClip = v; }

    // ================= CONSTANTS =================
    // Formant frequencies (Hz) — Hillenbrand et al. (1995) adult male averages
    // Vowel order: a (hod), e (hayed), i (heed), o (hoed), u (who'd)
    float[5] f1Freqs = (768.0f, 476.0f, 342.0f, 497.0f, 378.0f);
    float[5] f2Freqs = (1333.0f, 2089.0f, 2322.0f, 910.0f, 997.0f);
    float[5] f3Freqs = (2522.0f, 2691.0f, 3000.0f, 2459.0f, 2343.0f);
    float[5] f4Freqs = (3687.0f, 3677.0f, 3657.0f, 3384.0f, 3357.0f);

    // Per-formant Q derived from measured bandwidths (Q = freq / bandwidth)
    // Bandwidths (Hz): a(89,117,153,259) e(58,92,113,195) i(53,84,107,183) o(71,85,148,235) u(56,76,133,217)
    float[5] f1Q = (8.6f, 8.2f, 6.5f, 7.0f, 6.8f);
    float[5] f2Q = (11.4f, 11.0f, 11.0f, 10.7f, 11.0f);
    float[5] f3Q = (11.0f, 11.0f, 11.0f, 11.0f, 11.0f);
    float[5] f4Q = (11.0f, 11.0f, 11.0f, 11.0f, 11.0f);

    // Per-formant amplitude (relative gain) per vowel
    float[5] f1Amp = (1.0f, 1.0f, 1.0f, 1.0f, 1.0f);
    float[5] f2Amp = (0.50f, 0.70f, 0.80f, 0.35f, 0.30f);
    float[5] f3Amp = (0.25f, 0.30f, 0.45f, 0.15f, 0.12f);
    float[5] f4Amp = (0.10f, 0.12f, 0.15f, 0.08f, 0.06f);
    
    float pi = 3.14159265359f;
    float controlSmoothTimeSec = 0.02f;

    // ================= FILTER STRUCTURE =================
    struct SVFState
    {
        float lo, band, hi;
    }

    SVFState f1L, f2L, f3L, f4L;
    SVFState f1R, f2R, f3R, f4R;

    // ================= DSP FUNCTIONS =================

    float clampf(float v, float lo, float hi)
    {
        return v < lo ? lo : (v > hi ? hi : v);
    }

    float processBPF(SVFState& s, float sample, float cutoff, float Q)
    {
        let sampleRate = float(processor.frequency);
        let nyquist = sampleRate * 0.49f;
        let safeCutoff = cutoff < nyquist ? cutoff : nyquist;
        let safeQ = clampf(Q, 0.2f, 24.0f);
        
        let arg = pi * safeCutoff / sampleRate;
        let omega = 2.0f * float(sin(float64(arg)));
        let qVal = 1.0f / safeQ;

        s.lo = s.lo + (omega * s.band);
        s.hi = sample - s.lo - (qVal * s.band);
        s.band = s.band + (omega * s.hi);

        return s.band;
    }

    float applySoftClip(float sample, float amount)
    {
        let safeAmount = clampf(amount, 0.0f, 1.0f);
        let drive = 1.0f + (safeAmount * 7.0f);
        let driven = sample * drive;
        let shaped = float(tanh(float64(driven))) / float(tanh(float64(drive)));

        return sample + safeAmount * (shaped - sample);
    }

    float getInterpolatedFormant(float[5] table, float pos)
    {
        let idx = int(floor(float64(pos)));
        let clampedIdx = idx < 0 ? 0 : (idx > 4 ? 4 : idx);
        let frac = pos - float(clampedIdx);
        let nextIdx = clampedIdx + 1 < 5 ? clampedIdx + 1 : 4;
        
        let val1 = table.at(clampedIdx);
        let val2 = table.at(nextIdx);
        
        return val1 + frac * (val2 - val1);
    }

    float64 driftPhase = 0.0;

    void main()
    {
        loop
        {
            let inL = in[0];
            let inR = in[1];
            let sampleRate = float(processor.frequency);
            let controlAlpha = 1.0f - float(exp(float64(-1.0f / (sampleRate * controlSmoothTimeSec))));

            vowelPos = vowelPos + ((targetVowelPos - vowelPos) * controlAlpha);
            brightness = brightness + ((targetBrightness - brightness) * controlAlpha);
            resonance = resonance + ((targetResonance - resonance) * controlAlpha);
            mixParam = mixParam + ((targetMixParam - mixParam) * controlAlpha);
            formantShift = formantShift + ((targetFormantShift - formantShift) * controlAlpha);
            softClip = softClip + ((targetSoftClip - softClip) * controlAlpha);

            vowelPos = clampf(vowelPos, 0.0f, 4.0f);
            brightness = clampf(brightness, 0.5f, 2.0f);
            resonance = clampf(resonance, 3.5f, 20.0f);
            mixParam = clampf(mixParam, 0.0f, 1.0f);
            formantShift = clampf(formantShift, 0.5f, 2.0f);
            softClip = clampf(softClip, 0.0f, 1.0f);

            let driftVal = float(sin(driftPhase * 6.28318530718));
            driftPhase = driftPhase + (0.15 * processor.period);
            if (driftPhase >= 1.0) 
                driftPhase = driftPhase - 1.0;

            let f1 = getInterpolatedFormant(f1Freqs, vowelPos);
            let f2 = getInterpolatedFormant(f2Freqs, vowelPos);
            let f3 = getInterpolatedFormant(f3Freqs, vowelPos);
            let f4 = getInterpolatedFormant(f4Freqs, vowelPos);

            let drift = 1.0f + (driftVal * 0.01f);
            let formantMod = formantShift * drift;
            let f1Mod = f1 * formantMod;
            let f2Mod = f2 * formantMod;
            let f3Mod = f3 * formantMod;
            let f4Mod = f4 * formantMod;

            // Per-formant Q from tables, scaled by resonance parameter
            let brightNorm = clampf((brightness - 0.5f) / 1.5f, 0.0f, 1.0f);
            let resScale = resonance / 8.0f;
            let q1 = clampf(getInterpolatedFormant(f1Q, vowelPos) * resScale, 1.0f, 18.0f);
            let q2 = clampf(getInterpolatedFormant(f2Q, vowelPos) * resScale, 1.0f, 22.0f);
            let q3 = clampf(getInterpolatedFormant(f3Q, vowelPos) * resScale, 1.0f, 22.0f);
            let q4 = clampf(getInterpolatedFormant(f4Q, vowelPos) * resScale, 1.0f, 18.0f);

            let v1L = processBPF(f1L, inL, f1Mod, q1);
            let v2L = processBPF(f2L, inL, f2Mod, q2);
            let v3L = processBPF(f3L, inL, f3Mod, q3);
            let v4L = processBPF(f4L, inL, f4Mod, q4);

            let v1R = processBPF(f1R, inR, f1Mod, q1);
            let v2R = processBPF(f2R, inR, f2Mod, q2);
            let v3R = processBPF(f3R, inR, f3Mod, q3);
            let v4R = processBPF(f4R, inR, f4Mod, q4);

            // Per-formant amplitude from tables, brightness boosts upper formants
            let a1 = getInterpolatedFormant(f1Amp, vowelPos);
            let a2 = getInterpolatedFormant(f2Amp, vowelPos) * (0.85f + brightNorm * 0.3f);
            let a3 = getInterpolatedFormant(f3Amp, vowelPos) * (0.7f + brightNorm * 0.6f);
            let a4 = getInterpolatedFormant(f4Amp, vowelPos) * (0.5f + brightNorm * 1.0f);

            let wetL = (v1L * a1) + (v2L * a2) + (v3L * a3) + (v4L * a4);
            let wetR = (v1R * a1) + (v2R * a2) + (v3R * a3) + (v4R * a4);
            
            let mixedL = inL + mixParam * (wetL - inL);
            let mixedR = inR + mixParam * (wetR - inR);

            let outL = applySoftClip(mixedL, softClip);
            let outR = applySoftClip(mixedR, softClip);

            out <- float<2>(outL, outR);
            advance();
        }
    }
}
